#!/bin/sh
#
# dawn-satellite-fetch-models — download the satellite's ML models into
# /var/lib/dawn-satellite/models, directly from upstream (the SAME sources the
# repo's setup_models.sh uses).  Operator-run (root); NOT called from the .deb
# maintainer scripts (Debian policy forbids network access in postinst), and the
# model licenses are a deliberate operator choice.
#
# Always fetches:  Silero VAD + the Piper "Alba" TTS voice (committed in the
#                  DAWN repo; see their *_LICENSE files there).
# ASR engine (match [asr] engine in /etc/dawn-satellite/satellite.toml):
#   --asr whisper          Whisper batch model (DEFAULT; matches the shipped config
#                          and the packaged binary, which is built with Whisper)
#   --asr vosk             Vosk small streaming model (needs a Vosk build)
#   --whisper-model SIZE   tiny-q5_1 (default), tiny, base-q5_1, base, small, medium
#   --accept               skip the license prompt
#
#   dawn-satellite-fetch-models [--asr vosk|whisper] [--whisper-model SIZE] [--accept]
#
# Sources (HTTPS only): huggingface.co (Whisper, MIT), alphacephei.com (Vosk,
# Apache-2.0), github.com (Piper Alba voice + Silero VAD).  Override the repo
# location with DAWN_MODELS_REF (default: main) or DAWN_RAW_BASE.
set -eu

MODELS_DIR="${MODELS_DIR:-/var/lib/dawn-satellite/models}"
SERVICE_USER="${SERVICE_USER:-dawn}"
DAWN_MODELS_REF="${DAWN_MODELS_REF:-main}"
DAWN_RAW_BASE="${DAWN_RAW_BASE:-https://github.com/The-OASIS-Project/dawn/raw/${DAWN_MODELS_REF}/models}"
HF_WHISPER_BASE="https://huggingface.co/ggerganov/whisper.cpp/resolve/main"
VOSK_BASE="https://alphacephei.com/vosk/models"

ASR="whisper"
WHISPER_MODEL="tiny-q5_1"
ACCEPT=0

die() {
   echo "fetch-models: $*" >&2
   exit 1
}

while [ $# -gt 0 ]; do
   case "$1" in
      --asr) ASR="${2:-}"; shift 2 ;;
      --whisper-model) WHISPER_MODEL="${2:-}"; shift 2 ;;
      --accept) ACCEPT=1; shift ;;
      -h | --help)
         sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
         exit 0
         ;;
      *) die "unknown option: $1 (try --help)" ;;
   esac
done

case "$ASR" in vosk | whisper) ;; *) die "--asr must be vosk or whisper" ;; esac
case "$WHISPER_MODEL" in
   tiny | base | small | medium | tiny-q5_1 | base-q5_1) ;;
   *) die "--whisper-model must be tiny-q5_1|tiny|base-q5_1|base|small|medium" ;;
esac

[ "$(id -u)" -eq 0 ] || die "must run as root (writes $MODELS_DIR)"
command -v curl >/dev/null 2>&1 || die "curl is required (sudo apt install curl)"
if [ "$ASR" = vosk ]; then
   command -v unzip >/dev/null 2>&1 || die "unzip is required for --asr vosk (sudo apt install unzip)"
fi

if [ "$ASR" = whisper ]; then
   ASR_DESC="Whisper $WHISPER_MODEL (MIT)"
else
   ASR_DESC="Vosk small streaming (Apache-2.0)"
fi

echo "=== DAWN satellite models → $MODELS_DIR ==="
echo "  - Silero VAD            (see SILERO_VAD_LICENSE in the DAWN repo)"
echo "  - Piper TTS voice Alba  (see PIPER_ALBA_LICENSE in the DAWN repo)"
echo "  - ASR: $ASR_DESC"
echo "Downloaded over HTTPS from huggingface.co / alphacephei.com / github.com."
if [ "$ACCEPT" -ne 1 ]; then
   printf "Proceed and accept the model licenses above? [y/N] "
   read -r reply
   case "$reply" in
      y | Y | yes | YES) ;;
      *) die "aborted (no models downloaded)" ;;
   esac
fi

# curl -f: fail (non-zero) on an HTTP error so a 404 aborts instead of writing an
# error page over a model file.  --create-dirs makes the whisper.cpp/ subdir.
get() { # get <url> <dest>
   echo "  → $2"
   curl -fL --proto '=https' --create-dirs -o "$2" "$1" || die "download failed: $1"
}

mkdir -p "$MODELS_DIR"

# Always: VAD + Piper TTS voice (.onnx + its required .json config).
get "$DAWN_RAW_BASE/silero_vad_16k_op15.onnx" "$MODELS_DIR/silero_vad_16k_op15.onnx"
get "$DAWN_RAW_BASE/en_GB-alba-medium.onnx" "$MODELS_DIR/en_GB-alba-medium.onnx"
get "$DAWN_RAW_BASE/en_GB-alba-medium.onnx.json" "$MODELS_DIR/en_GB-alba-medium.onnx.json"

# ASR engine.
if [ "$ASR" = whisper ]; then
   # Upstream's names, as in the satellite config: tiny -> ggml-tiny.en.bin,
   # tiny-q5_1 -> ggml-tiny.en-q5_1.bin.
   case "$WHISPER_MODEL" in
      *-*) wfile="ggml-${WHISPER_MODEL%%-*}.en-${WHISPER_MODEL#*-}.bin" ;;
      *) wfile="ggml-${WHISPER_MODEL}.en.bin" ;;
   esac
   get "$HF_WHISPER_BASE/$wfile" "$MODELS_DIR/whisper.cpp/$wfile"
else
   vosk="vosk-model-small-en-us-0.15"
   if [ -d "$MODELS_DIR/$vosk" ]; then
      echo "  → $vosk (already present)"
   else
      tmp="$(mktemp -d "${TMPDIR:-/tmp}/dawn-vosk.XXXXXX")"
      trap 'rm -rf "$tmp"' EXIT
      get "$VOSK_BASE/${vosk}.zip" "$tmp/${vosk}.zip"
      echo "  → extracting $vosk"
      unzip -q "$tmp/${vosk}.zip" -d "$MODELS_DIR" || die "unzip failed"
   fi
fi

chown -R "$SERVICE_USER:$SERVICE_USER" "$MODELS_DIR" 2>/dev/null || true
echo "Done.  Models in $MODELS_DIR."
echo "Set [asr] engine = \"$ASR\" in /etc/dawn-satellite/satellite.toml, then:"
echo "  sudo systemctl restart dawn-satellite"
