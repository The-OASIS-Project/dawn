build*/
libvosk.so
vosk-model*/

# Benchmark extraction snapshots (memory-pipeline cache; rebuilt on demand)
benchmarks/snapshots*/

# Runtime config files (user-specific, may contain secrets)
dawn.toml
secrets.toml

# Debug recordings
aec_*.wav
mic_*.wav
asr_*.wav

__pycache__/
node_modules/

# SSL certificates and keys (generated per-deployment)
ssl/
dawn_satellite_arduino/ca_cert.h

# Arduino secrets (WiFi credentials, server IP)
dawn_satellite_arduino/arduino_secrets.h

# OTA verify key (operator's Ed25519 public key, baked per-deployment)
dawn_satellite_arduino/ota_pubkey.h

# Downloaded models (not shipped in repo)
models/embeddings/
models/whisper.cpp

# Build artifacts
*.a
*.db

# Runtime data
logs/

# Backup files
*.bak
*-db.bak*/

# Test output and compiled test binaries
tests/summarizer_results*/
tests/test_audio_decoder
tests/test_playlist_formats
tests/test_tts_preprocessing
tests/test_vad_models/

# LLM testing results (historical, not tracked)
llm_testing/results/archive/
llm_testing/results/config_search/
llm_testing/results/fine_tuning/
llm_testing/results/model_tests/
llm_testing/results/quality_tests/
llm_testing/scripts/archive/

# Local planning/tracking docs (not for git)
docs/TODO.md
docs/DONE.md
.cleanup-state.md

# Local-only git hook extensions.  Chained from pre-commit.hook /
# pre-push.hook if present and executable.  For per-developer policies that
# shouldn't live in the public repo.
*.local.hook

# LLM quality suite: local captures, results, labels, logs and personas
llm_testing/quality/.judge_cache.json
llm_testing/quality/captures*/
llm_testing/quality/personas/
llm_testing/quality/*.json
llm_testing/quality/*.log
quality_[0-9]*.json
