#!/bin/sh
# dawn postinst: system user, state directories, config from templates, shipped
# models, systemd.  Runs offline; the models too big to ship are downloaded by
# dawn-models.service when dawn first starts.
set -e

SHARE=/usr/share/dawn
DATA=/var/lib/dawn
CONF=/etc/dawn

# link <target> <link>: point <link> at <target> unless <link> is the operator's own
# file (anything but a symlink), which is left alone.
link() {
   if [ ! -e "$2" ] || [ -L "$2" ]; then
      ln -sfn "$1" "$2"
   fi
}

if [ "$1" = configure ]; then
   if ! getent group dawn >/dev/null; then
      addgroup --system dawn
   fi
   if ! getent passwd dawn >/dev/null; then
      adduser --system --ingroup dawn --home "$DATA" --no-create-home \
         --shell /usr/sbin/nologin --gecos "DAWN daemon" dawn
   fi

   # Created when missing, never re-owned: an operator's choices under
   # /var/lib/dawn (a bind-mounted db/, OTA keys) survive every upgrade.
   for d in "$DATA" "$DATA/db" "$DATA/models" "$DATA/ota"; do
      [ -d "$d" ] || install -d -m 750 -o dawn -g dawn "$d"
   done

   # The daemon rewrites dawn.toml and secrets.toml (and their .bak) on a WebUI
   # settings save, so it owns those files; the directory stays root's.  Not
   # conffiles: dpkg would mark every save a local change.
   [ -d "$CONF" ] || install -d -m 750 -o root -g dawn "$CONF"
   if [ ! -e "$CONF/dawn.toml" ]; then
      install -m 640 -o dawn -g dawn "$SHARE/conf/dawn.toml" "$CONF/dawn.toml"
   fi
   # Always present, or a secrets save from the WebUI would create
   # /var/lib/dawn/secrets.toml, which is read first and would shadow this one.
   if [ ! -e "$CONF/secrets.toml" ]; then
      install -m 600 -o dawn -g dawn "$SHARE/conf/secrets.toml" "$CONF/secrets.toml"
   fi
   for f in dawn.toml.bak secrets.toml.bak; do
      [ -e "$CONF/$f" ] || install -m 600 -o dawn -g dawn /dev/null "$CONF/$f"
   done

   # Shipped models and tool instructions, where the daemon looks for them
   # (relative to its working directory, /var/lib/dawn).
   for m in "$SHARE"/models/*; do
      link "$m" "$DATA/models/${m##*/}"
   done
   link "$SHARE/tool_instructions" "$DATA/tool_instructions"
fi

# systemd, as debhelper's dh_installsystemd --no-start does it: enable on first
# install, keep the operator's choice after that, restart a running daemon onto
# the new version.
if [ "$1" = configure ] || [ "$1" = abort-upgrade ] || [ "$1" = abort-deconfigure ] ||
   [ "$1" = abort-remove ]; then
   deb-systemd-helper unmask dawn.service >/dev/null || true
   if deb-systemd-helper --quiet was-enabled dawn.service; then
      deb-systemd-helper enable dawn.service >/dev/null || true
   else
      deb-systemd-helper update-state dawn.service >/dev/null || true
   fi
   if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
      systemctl --system daemon-reload >/dev/null || true
      if [ -n "$2" ]; then
         deb-systemd-invoke try-restart dawn.service >/dev/null || true
      fi
   fi
fi

if [ "$1" = configure ] && [ -z "$2" ]; then
   cat <<'EOF'

DAWN is installed and enabled, but not started.
  1. Start it:          sudo systemctl start dawn
                        (the first start downloads about 180 MB of models)
  2. Create the admin:  sudo journalctl -u dawn | grep -A6 'SETUP TOKEN'
                        sudo dawn-admin user create <name> --admin
                        (the token is valid for 5 minutes; restart dawn for a new one)
  3. Trust this host's DAWN CA, /etc/dawn/ssl/ca.crt (made on first start): import
     it in your browser, or copy it to each client as dawn-ca.crt and run
        sudo cp dawn-ca.crt /usr/local/share/ca-certificates/ && sudo update-ca-certificates
     Satellites take it as their ca_cert_path.
  4. Open https://<this-host>:3000, sign in, and add an LLM API key under
     Settings (or in /etc/dawn/secrets.toml, then: sudo systemctl restart dawn).
Configuration: /etc/dawn/dawn.toml   Every option: /usr/share/doc/dawn/dawn.toml.example
EOF
fi

exit 0
