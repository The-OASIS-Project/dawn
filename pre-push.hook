#!/bin/bash
#
# Pre-push hook — verify the CI test suite passes before pushing.
#
# Catches regressions that get past the developer's local workflow: missing
# test stubs, production code broken on paths only exercised by tests, code
# that compiles but fails at runtime.  This session's `fact_stems` column
# bug + 4 missing test stubs are the motivating example.
#
# SCOPE: fast checks only — build the CI test targets and run the `ci`-labelled
# ctest suite, and only when the pushed commits change source or build files.  The heavier build-config checks moved to GitHub Actions
# (.github/workflows/ci.yml) so the hook stays quick:
#   - Tier-1 satellite build  -> `satellite-build` job (headless, apt-only).
#   - Server daemon link+start -> `docker-build` job (`dawn --help`).
# The full ML preset-matrix smoke (local/full/debug/+email) cannot run on stock
# runners — the daemon unconditionally links ONNX Runtime + Piper, which aren't
# apt packages — so it stays a developer/release-time manual check:
#   ./tests/smoke_test.sh
#
# Optional local extension: if pre-push.local.hook exists and is executable
# (in this checkout, or in the main checkout when this is a worktree), it
# runs before the test check, with git's pushed-refs lines on its stdin.
# Use for per-developer checks that shouldn't live in the public repo.
# Gitignored.
#
# Install: ./install-git-hooks.sh
# Bypass:  git push --no-verify
#

# Change to repository root
cd "$(git rev-parse --show-toplevel)" || exit 1

# git's pushed-refs lines ("<local ref> <sha> <remote ref> <sha>"), kept for
# the local extension: the build below must not be what reads them.
PUSHED_REFS=""
if [ ! -t 0 ]; then
   PUSHED_REFS=$(cat)
fi

# Find a local extension: this checkout's, else the main checkout's.  A git
# worktree shares the main checkout's hooks but not its gitignored files, so
# without the fallback a worktree would skip the extension without a word.
find_local_hook() {
   if [ -x "./$1" ]; then
      echo "./$1"
      return
   fi
   local common main
   common=$(git rev-parse --git-common-dir 2>/dev/null) || return
   main=$(cd "$common/.." 2>/dev/null && pwd) || return
   if [ -x "$main/$1" ]; then
      echo "$main/$1"
   fi
}

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Optional local-only pre-push extension (find_local_hook), run first: it is
# quick, and it must run even where there is no build directory to test.
# Gitignored (*.local.hook).  It gets the pushed-refs lines git gave this hook.
LOCAL_HOOK=$(find_local_hook pre-push.local.hook)
if [ -n "$LOCAL_HOOK" ]; then
   if [ -n "$PUSHED_REFS" ]; then
      printf '%s\n' "$PUSHED_REFS" | "$LOCAL_HOOK" "$@"
   else
      "$LOCAL_HOOK" "$@" </dev/null
   fi
   LOCAL_RC=$?
   if [ "$LOCAL_RC" -ne 0 ]; then
      echo ""
      echo -e "${RED}Local pre-push extension failed (exit $LOCAL_RC).${NC}"
      echo -e "${YELLOW}Bypass: git push --no-verify${NC}"
      exit "$LOCAL_RC"
   fi
fi

# Find an existing build directory.  Prefer build-ci first — that's the
# preset CI itself runs (ENABLE_WEBUI=OFF, no CUDA).  Running the test
# suite against build-debug (the developer's daily driver) hides failures
# that only show without the WebUI; build-ci catches them.
# build-debug stays as a fallback for developers who haven't bootstrapped
# build-ci yet.
BUILD_DIR=""
for d in build-ci build-debug build-full build; do
   if [ -f "$d/CMakeCache.txt" ]; then
      BUILD_DIR="$d"
      break
   fi
done

if [ -z "$BUILD_DIR" ]; then
   echo -e "${YELLOW}Pre-push: no build directory found; skipping test check.${NC}"
   echo -e "${YELLOW}  Bootstrap with: cmake --preset ci${NC}"
   exit 0
fi

# Only pushed commits that change source or build files (the same paths the
# pre-commit hook tests for: everything the tests compile or read, including
# the two WebUI files the shell checks in tests/CMakeLists.txt read) need the
# build and the suite.  When git gives no pushed refs, or a range can't be
# read, run them.  Renames are off so a move reports the path it left.
SOURCE_RE='^(src|include|common|tests|benchmarks|cmake|third_party|dawn_satellite|models)/|^(whisper\.cpp|models\.toml|CMakePresets\.json)$|^www/js/ui/(memory_aliases\.js|settings/schema\.js)$|(^|/)CMakeLists\.txt$|\.cmake$'
pushed_source_changes() {
   [ -z "$PUSHED_REFS" ] && return 0
   local zero=0000000000000000000000000000000000000000
   local lref lsha rref rsha files
   while read -r lref lsha rref rsha; do
      if [ -z "$lsha" ] || [ "$lsha" = "$zero" ]; then
         continue # deleting a ref: nothing to test
      fi
      if [ "$rsha" = "$zero" ]; then
         files=$(git log -m --no-renames --format= --name-only "$lsha" --not --remotes) || return 0
      else
         files=$(git diff --no-renames --name-only "$rsha" "$lsha" 2>/dev/null) || return 0
      fi
      if printf '%s\n' "$files" | grep -qE "$SOURCE_RE"; then
         return 0
      fi
   done <<< "$PUSHED_REFS"
   return 1
}

if ! pushed_source_changes; then
   echo -e "${GREEN}Pre-push: no source or build files in the pushed commits; skipping the test suite.${NC}"
   exit 0
fi

BUILD_LOG=$(mktemp -t dawn-prepush-build.XXXXXX.log)
TEST_LOG=$(mktemp -t dawn-prepush-test.XXXXXX.log)
# The tests' scratch files on a RAM disk where there is one: SQLite's syncs to
# disk were most of the suite's time, and no test checks durability across a
# power loss.  Only ctest sees it; the logs above stay in the usual place.
TEST_TMP=""
# It needs room for the parallel suite's scratch files (one test alone writes a
# 64 MiB blob), and a container's /dev/shm is often only 64 MiB: check first.
TEST_TMP_MIN_KB=1048576
SHM_FREE_KB=$(df -Pk /dev/shm 2>/dev/null | awk 'NR == 2 { print $4 }')
if [ -d /dev/shm ] && [ -w /dev/shm ] && [ "${SHM_FREE_KB:-0}" -ge "$TEST_TMP_MIN_KB" ] 2>/dev/null; then
   TEST_TMP=$(mktemp -d /dev/shm/dawn-tests.XXXXXX 2>/dev/null) || TEST_TMP=""
fi
trap 'rm -f "$BUILD_LOG" "$TEST_LOG"; [ -n "$TEST_TMP" ] && rm -rf "$TEST_TMP"' EXIT

echo -e "${BLUE}Pre-push: building tests-ci in $BUILD_DIR…${NC}"
if ! make -C "$BUILD_DIR" -j"$(nproc)" tests-ci > "$BUILD_LOG" 2>&1; then
   echo -e "${RED}Test build FAILED.  Last 30 lines:${NC}"
   tail -30 "$BUILD_LOG"
   echo
   echo -e "${YELLOW}Bypass: git push --no-verify${NC}"
   # Preserve the log on failure for the dev to inspect.
   PRESERVED=$(mktemp -t dawn-prepush-build-failed.XXXXXX.log)
   cp "$BUILD_LOG" "$PRESERVED"
   echo -e "${YELLOW}Full log preserved at: $PRESERVED${NC}"
   exit 1
fi

echo -e "${BLUE}Pre-push: running CI test suite…${NC}"
if ! TMPDIR="${TEST_TMP:-${TMPDIR:-/tmp}}" ctest --test-dir "$BUILD_DIR" -j"$(nproc)" \
   --output-on-failure --no-tests=error -L ci > "$TEST_LOG" 2>&1; then
   echo -e "${RED}Test suite FAILED.  Failing cases:${NC}"
   # Highlight FAIL/Failed lines + tail the summary block.
   grep -E "FAIL:|\*\*\*Failed|tests failed" "$TEST_LOG" | head -20
   echo
   echo -e "${YELLOW}Reproduce: ctest --test-dir $BUILD_DIR --output-on-failure -L ci${NC}"
   echo -e "${YELLOW}Bypass:    git push --no-verify${NC}"
   PRESERVED=$(mktemp -t dawn-prepush-test-failed.XXXXXX.log)
   cp "$TEST_LOG" "$PRESERVED"
   echo -e "${YELLOW}Full log preserved at: $PRESERVED${NC}"
   exit 1
fi

# Success — pull the pass count for a clean summary line.
PASS_LINE=$(grep -E "tests passed" "$TEST_LOG" | tail -1)
if [ -n "$PASS_LINE" ]; then
   echo -e "${GREEN}Pre-push: $PASS_LINE${NC}"
else
   echo -e "${GREEN}Pre-push: test suite passed.${NC}"
fi

# NOTE: the Tier-1 satellite build and the build-config (preset-matrix) daemon
# smoke used to run here.  They moved to GitHub Actions (satellite-build +
# docker-build jobs) so the hook stays fast; the full ML preset matrix that can't
# run on stock runners stays a manual `./tests/smoke_test.sh` (see header).

exit 0
