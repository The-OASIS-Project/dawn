# DAWN Configuration File
# ========================
# Copy this file to one of:
#   ./dawn.toml                    (current directory - highest priority)
#   ~/.config/dawn/dawn.toml       (user config)
#   /etc/dawn/dawn.toml            (system-wide)
#
# Or specify explicitly: dawn --config /path/to/config.toml
#
# Values shown are defaults. Uncomment and modify as needed.
# Use --dump-config to see the effective configuration.
# Use --dump-settings to see all settings with their sources and env var names.
#
# Environment variables: Each setting can be overridden via DAWN_<SECTION>_<KEY>
# Example: [audio] capture_device -> DAWN_AUDIO_CAPTURE_DEVICE

# =============================================================================
# General Settings
# =============================================================================

[general]
# ai_name = "friday"              # Wake word / assistant name (lowercase)
                                  # Env: DAWN_GENERAL_AI_NAME
# log_file = ""                   # Log to file (empty = console only)
                                  # Env: DAWN_GENERAL_LOG_FILE

[persona]
# description = ""                # Custom AI personality description
                                  # Leave empty to use built-in persona
                                  # Env: DAWN_PERSONA_DESCRIPTION

[localization]
# location = ""                   # Your location (e.g., "New York, NY")
                                  # Used for weather and contextual responses
                                  # Env: DAWN_LOCALIZATION_LOCATION
# timezone = ""                   # Timezone (e.g., "America/New_York")
                                  # Empty = system default
                                  # Env: DAWN_LOCALIZATION_TIMEZONE
# units = "imperial"              # "imperial" or "metric"
                                  # Env: DAWN_LOCALIZATION_UNITS

# =============================================================================
# Audio Settings
# =============================================================================

[audio]
# backend = "auto"                # "auto", "alsa", or "pulse"
                                  # Env: DAWN_AUDIO_BACKEND
# capture_device = "default"      # Microphone device (use `arecord -L` to list)
                                  # Env: DAWN_AUDIO_CAPTURE_DEVICE
# playback_device = "default"     # Speaker device (use `aplay -L` to list)
                                  # Env: DAWN_AUDIO_PLAYBACK_DEVICE
# output_rate = 44100             # Playback sample rate (44100 or 48000)
                                  # Env: DAWN_AUDIO_OUTPUT_RATE
# output_channels = 2             # Playback channels (2 = stereo, required for dmix)
                                  # Env: DAWN_AUDIO_OUTPUT_CHANNELS

[audio.bargein]
# enabled = true                  # Allow interrupting TTS with speech
                                  # Env: DAWN_AUDIO_BARGEIN_ENABLED
# cooldown_ms = 1500              # Keep high VAD threshold after TTS stops
                                  # Env: DAWN_AUDIO_BARGEIN_COOLDOWN_MS
# startup_cooldown_ms = 300       # Block barge-in when TTS starts
                                  # Env: DAWN_AUDIO_BARGEIN_STARTUP_COOLDOWN_MS

# =============================================================================
# Voice Activity Detection (VAD)
# =============================================================================

[vad]
# speech_threshold = 0.50         # Sensitivity for detecting speech (0.0-1.0)
                                  # Lower = more sensitive
                                  # Env: DAWN_VAD_SPEECH_THRESHOLD
# speech_threshold_tts = 0.92     # Higher threshold during TTS playback
                                  # Prevents echo from triggering VAD
                                  # Env: DAWN_VAD_SPEECH_THRESHOLD_TTS
# silence_threshold = 0.30        # Below this probability = silence
                                  # Env: DAWN_VAD_SILENCE_THRESHOLD
# end_of_speech_duration = 1.2    # Seconds of silence to end recording
                                  # Env: DAWN_VAD_END_OF_SPEECH_DURATION
# max_recording_duration = 30.0   # Maximum recording length in seconds
                                  # Env: DAWN_VAD_MAX_RECORDING_DURATION
# preroll_ms = 500                # Audio to keep before speech detected
                                  # Env: DAWN_VAD_PREROLL_MS

[vad.chunking]
# enabled = true                  # Enable chunked transcription for long utterances
                                  # Env: DAWN_VAD_CHUNKING_ENABLED
# pause_duration = 0.30           # Silence duration (seconds) to trigger chunk boundary
                                  # Env: DAWN_VAD_CHUNKING_PAUSE_DURATION
# min_duration = 1.0              # Minimum chunk duration (seconds)
                                  # Env: DAWN_VAD_CHUNKING_MIN_DURATION
# max_duration = 10.0             # Maximum chunk duration (seconds)
                                  # Env: DAWN_VAD_CHUNKING_MAX_DURATION

# =============================================================================
# Automatic Speech Recognition (ASR)
# =============================================================================

[asr]
# model = "base"                  # Whisper model: "tiny", "base", "small", "medium"
                                  # tiny=fastest, medium=most accurate
                                  # Env: DAWN_ASR_MODEL
# models_path = "models/whisper.cpp"  # Path to Whisper model files
                                  # Env: DAWN_ASR_MODELS_PATH
# dedup_window_sec = 4            # Cross-device utterance dedup window (seconds).
                                  # When the local mic and a nearby satellite both
                                  # hear one command, only the first proceeds; the
                                  # rest are suppressed within this window. 0 disables.
                                  # Default ASR_DEDUP_WINDOW_SEC_DEFAULT, max
                                  # ASR_DEDUP_WINDOW_SEC_MAX (dawn_config.h).
                                  # Runtime-tunable. Env: DAWN_ASR_DEDUP_WINDOW_SEC
# disambiguation_hint = ""        # Prompt hint injected on voice-input surfaces
                                  # (satellites, local mic, WebUI voice turns) warning
                                  # the LLM its input was speech-transcribed and may
                                  # contain homophone / similar-sounding mis-recognitions
                                  # to interpret from context. Leave empty for the
                                  # built-in default (DEFAULT_ASR_DISAMBIGUATION_HINT).
                                  # Multi-line allowed ('''...'''). Editable in the WebUI
                                  # Speech Recognition panel. Env: DAWN_ASR_DISAMBIGUATION_HINT

# =============================================================================
# Text-to-Speech (TTS)
# =============================================================================

[tts]
# models_path = "models"          # Path to TTS model files
                                  # Env: DAWN_TTS_MODELS_PATH
# voice_model = "en_GB-alba-medium"  # Piper voice model name
                                  # Included: en_GB-alba-medium, en_GB-northern_english_male-medium
                                  # Env: DAWN_TTS_VOICE_MODEL
# length_scale = 0.85             # Speech speed: <1.0 = faster, >1.0 = slower
                                  # Env: DAWN_TTS_LENGTH_SCALE
# voice_directive = ""            # Spoken-output shaping directive for satellites +
                                  # local mic (reply is read aloud, not shown). Steers
                                  # the LLM toward concise, speech-friendly answers
                                  # (no markdown/tables/lists). Leave empty for the
                                  # built-in default (DEFAULT_VOICE_OUTPUT_DIRECTIVE).
                                  # Multi-line allowed ('''...'''). Editable in the WebUI
                                  # Text-to-Speech panel. Env: DAWN_TTS_VOICE_DIRECTIVE
# voice_directive_webui = ""      # Softer spoken-output directive for WebUI voice turns
                                  # (whole reply is read aloud, but the screen can still
                                  # show visuals via render_visual/images). Leave empty
                                  # for the built-in default
                                  # (DEFAULT_VOICE_OUTPUT_DIRECTIVE_WEBUI).
                                  # Env: DAWN_TTS_VOICE_DIRECTIVE_WEBUI

# =============================================================================
# Command Processing
# =============================================================================

[commands]
# processing_mode = "direct_first"  # Command processing strategy:
                                    # "direct_only": Pattern matching only (fastest)
                                    # "llm_only": All commands via LLM (most flexible)
                                    # "direct_first": Try patterns, fall back to LLM
                                    # Env: DAWN_COMMANDS_PROCESSING_MODE

# =============================================================================
# Large Language Model (LLM)
# =============================================================================

[llm]
# type = "cloud"                  # "cloud" or "local"
                                  # Env: DAWN_LLM_TYPE
# max_tokens = 8192               # Maximum response tokens
                                  # Env: DAWN_LLM_MAX_TOKENS
# compact_soft_threshold = 0.60   # Async background compaction trigger
# compact_hard_threshold = 0.85   # Blocking compaction trigger (safety net)
# compact_use_session = true      # Use session's LLM for compaction (false = dedicated)
# compact_provider = ""           # Dedicated compaction provider: claude/openai/gemini/local
# compact_model = ""              # Dedicated compaction model (e.g., claude-haiku-4-5)
# compact_openrouter_model = ""   # Compaction model when the OpenRouter gateway is on
                                  # ("vendor/model", e.g. anthropic/claude-3.5-haiku).
                                  # Empty = use the main OpenRouter default model.
# conversation_logging = false    # Save chat history to log files (WebUI saves to DB)
                                  # Env: DAWN_LLM_CONVERSATION_LOGGING
# rate_limit_enabled = true       # Throttle cloud API calls to avoid 429 errors
                                  # Env: DAWN_LLM_RATE_LIMIT_ENABLED
# rate_limit_rpm = 40             # Max cloud API requests per minute
                                  # Env: DAWN_LLM_RATE_LIMIT_RPM

[llm.cloud]
# provider = "openai"             # "openai", "claude", or "gemini"
                                  # Env: DAWN_LLM_CLOUD_PROVIDER
# endpoint = ""                   # Custom endpoint (empty = default provider URL)
                                  # Env: DAWN_LLM_CLOUD_ENDPOINT
# vision_enabled = true           # Cloud models typically support vision/images
                                  # Env: DAWN_LLM_CLOUD_VISION_ENABLED

# OpenRouter gateway mode. When true, ALL cloud traffic — chat AND the auxiliary
# memory-extraction / compaction / silent-observe / scheduler calls — routes through
# OpenRouter (https://openrouter.ai/api/v1) using openrouter_api_key from secrets.toml,
# regardless of the "provider" setting above. The direct provider/key fields are then
# unused. This keeps "which key am I using" unambiguous: either fully direct, or fully
# OpenRouter. The background tasks each have a SEPARATE OpenRouter-formatted model setting
# (compact_openrouter_model, memory.extraction_openrouter_model,
# llm.silent_observe.openrouter_model) used only when the gateway is on — so you don't have
# to rewrite the direct-API model names every time you toggle. Each falls back to the main
# OpenRouter default (openrouter_default_model_idx) when left empty.
# use_openrouter = false          # Env: DAWN_LLM_CLOUD_USE_OPENROUTER

# OpenAI endpoint selection. "auto" routes gpt-5.4* to /v1/responses (where
# function tools + reasoning are supported); other models continue to use
# /v1/chat/completions. "always" forces every OpenAI cloud call onto
# /v1/responses. "never" stays on /v1/chat/completions for everything (gpt-5.4
# will then fail with HTTP 400 if reasoning + tools are both active).
# openai_use_responses_api = "auto"  # "auto", "always", or "never"
                                  # Env: DAWN_LLM_CLOUD_OPENAI_USE_RESPONSES_API

# Model lists for quick switching via WebUI or voice
# First model in list is used when switching to that provider
# openai_models = ["gpt-5.4", "gpt-5.4-mini", "gpt-5.4-nano", "gpt-5.2", "gpt-5-mini", "gpt-5-nano", "o4-mini"]
# openai_default_model_idx = 0
# claude_models = ["claude-sonnet-4-5", "claude-opus-4-5", "claude-haiku-4-5"]
# claude_default_model_idx = 0
# gemini_models = ["gemini-2.5-flash", "gemini-2.5-pro", "gemini-3-flash-preview", "gemini-3-pro-preview"]
# gemini_default_model_idx = 0
# OpenRouter favorites (used when use_openrouter = true). IDs are "vendor/model".
# These are the curated shortlist shown in the header model switcher.
# openrouter_models = ["anthropic/claude-opus-4.7", "anthropic/claude-sonnet-4.6", "anthropic/claude-haiku-4.5", "openai/gpt-5.5", "openai/gpt-5.4-mini", "openai/gpt-5.4-nano", "google/gemini-3.1-pro-preview", "google/gemini-3.5-flash"]
# openrouter_default_model_idx = 1   # anthropic/claude-sonnet-4.6
                                  # Verify slugs against https://openrouter.ai/models

[llm.local]
# endpoint = "http://127.0.0.1:8080"  # Local LLM server endpoint
                                  # llama.cpp default: 8080, Ollama default: 11434
                                  # Env: DAWN_LLM_LOCAL_ENDPOINT
# model = ""                      # Model identifier (optional, server may auto-select)
                                  # Env: DAWN_LLM_LOCAL_MODEL
# vision_enabled = false          # Enable for vision models (LLaVA, Qwen-VL, etc.)
                                  # Env: DAWN_LLM_LOCAL_VISION_ENABLED
# provider = "auto"               # "auto", "ollama", "llama_cpp", or "generic"
                                  # "auto" probes endpoint to detect server type
                                  # Env: DAWN_LLM_LOCAL_PROVIDER

[llm.tools]
# mode = "native"                 # Tool/function calling mode:
                                  # "native": Use provider's native tool calling (recommended)
                                  # "command_tags": Extract JSON from <command> tags (legacy)
                                  # "disabled": No tool calling
                                  # Env: DAWN_LLM_TOOLS_MODE
# Per-tool gating — two models, chosen per surface (local = voice mic, remote =
# WebUI/satellite). DANGEROUS tools (shutdown, email, phone, document_manage)
# are NEVER auto-enabled under either model; list them in *_enabled to opt in.
#
# BLOCKLIST (recommended): all non-dangerous tools on EXCEPT those listed, so a
# newly-added tool works without editing config. When a *_disabled list is set,
# the matching *_enabled list governs ONLY dangerous-tool opt-in for that surface
# (it no longer controls non-dangerous tools — the blocklist does).
# local_disabled  = ["voice_amplifier"]                 # all non-dangerous on except these
# remote_disabled = ["hud_control", "faceplate", "tts"] # e.g. hide local-hardware tools remotely
#
# WHITELIST (legacy): only the listed (non-dangerous) tools are enabled. A new
# tool is OFF until you add it. Used when only *_enabled is set (no *_disabled).
# local_enabled  = []             # empty = none; absent = all on
# remote_enabled = []
#
# To opt a dangerous tool in (under either model), list it in *_enabled:
# remote_enabled = ["email", "phone"]

[llm.thinking]
# Extended thinking/reasoning mode for complex queries
# mode = "disabled"               # "disabled" or "enabled"
                                  # Env: DAWN_LLM_THINKING_MODE
# reasoning_effort = "medium"     # "low", "medium", "high" - selects which budget to use
                                  # Maps to provider-specific settings:
                                  # - OpenAI o-series/GPT-5: reasoning_effort parameter
                                  # - Claude: budget_tokens
                                  # - Gemini 2.5+: reasoning_effort (cannot fully disable)
                                  # - Local (llama.cpp): budget_tokens
                                  # Env: DAWN_LLM_THINKING_REASONING_EFFORT
# budget_low = 1024               # Token budget for "low" reasoning effort
                                  # Env: DAWN_LLM_THINKING_BUDGET_LOW
# budget_medium = 8192            # Token budget for "medium" reasoning effort
                                  # Env: DAWN_LLM_THINKING_BUDGET_MEDIUM
# budget_high = 16384             # Token budget for "high" reasoning effort
                                  # Env: DAWN_LLM_THINKING_BUDGET_HIGH
# budget_xhigh = 32768            # Token budget for "xhigh" reasoning effort (Claude only)
                                  # gpt-5.2/gpt-5.4 send xhigh natively to the API; older
                                  # OpenAI families and Gemini are clamped to "high".
                                  # Env: DAWN_LLM_THINKING_BUDGET_XHIGH
                                  # NOTE: Budgets are clamped to 50% of model context size

[llm.silent_observe]
# Silent-Observe primitive (Phase 0 of Dynamic Context Injection).
# Background observations DAWN makes about itself — calendar events, scheduled
# tasks, satellite registrations, etc.  Calls are non-streaming, no tools, no
# TTS, schema-validated, and audit-logged.  See
# docs/DYNAMIC_CONTEXT_INJECTION_DESIGN.md.
# provider = "local"              # "local" | "ollama" | "openai" | "claude" | "anthropic" | "gemini"
                                  # Env: DAWN_LLM_SILENT_OBSERVE_PROVIDER
# model = ""                      # Model name; empty = let provider pick a default
                                  # Env: DAWN_LLM_SILENT_OBSERVE_MODEL
# openrouter_model = ""           # Model when the OpenRouter gateway is on ("vendor/model",
                                  # e.g. anthropic/claude-3.5-haiku). Empty = main OpenRouter default.

# =============================================================================
# Web Search (SearXNG)
# =============================================================================

[search]
# engine = "searxng"              # Search provider:
                                  #   "searxng"  : local SearXNG instance (free, default)
                                  #   "tavily"   : commercial LLM-optimized API (requires
                                  #                tavily_api_key in secrets.toml; falls back
                                  #                to SearXNG on error or rate-limit)
                                  #   "disabled" : turn off web search entirely
                                  # Env: DAWN_SEARCH_ENGINE
# endpoint = "http://127.0.0.1:8384"  # SearXNG instance URL (used when engine = "searxng")
                                  # Env: DAWN_SEARCH_ENDPOINT
# title_filters = []              # Exclude results with these terms (case-insensitive)
                                  # Default filters spam like "wordle", "connections hints"

[search.summarizer]
# backend = "disabled"            # Summarize large search results:
                                  # "disabled": Return raw results
                                  # "local": Use dedicated local summarizer (llama-server)
                                  # "default": Use same LLM as conversation
                                  # "tfidf": Fast extractive summarization (no LLM needed)
                                  # Env: DAWN_SEARCH_SUMMARIZER_BACKEND
# threshold_bytes = 3072          # Summarize results larger than this
                                  # Env: DAWN_SEARCH_SUMMARIZER_THRESHOLD_BYTES
# target_words = 600              # Target summary length in words (for LLM backends)
                                  # Env: DAWN_SEARCH_SUMMARIZER_TARGET_WORDS
# target_ratio = 0.2              # Ratio of sentences to keep for TF-IDF (0.2 = 20%)
                                  # Env: DAWN_SEARCH_SUMMARIZER_TARGET_RATIO

# =============================================================================
# URL Fetcher
# =============================================================================

[url_fetcher]
# whitelist = []                  # Domains to always allow fetching (array of strings)
                                  # Example: ["github.com", "docs.python.org"]
# fallback = "flaresolverr"       # Fallback engine when direct libcurl fetch fails
                                  # (403, bot-block, JS-only page, <500 bytes extracted):
                                  #   "flaresolverr" : local Chromium-based bypass (default)
                                  #   "tavily"       : commercial /extract API (requires
                                  #                    tavily_api_key in secrets.toml)
                                  #   "none"         : no fallback; direct-fetch result is final
                                  # Env: DAWN_URL_FETCHER_FALLBACK

[url_fetcher.flaresolverr]
# enabled = false                 # Auto-fallback to FlareSolverr on 403 errors
                                  # Env: DAWN_URL_FETCHER_FLARESOLVERR_ENABLED
# endpoint = "http://127.0.0.1:8191/v1"  # FlareSolverr API endpoint
                                  # Env: DAWN_URL_FETCHER_FLARESOLVERR_ENDPOINT
# timeout_sec = 60                # Request timeout in seconds
                                  # Env: DAWN_URL_FETCHER_FLARESOLVERR_TIMEOUT_SEC
# max_response_bytes = 4194304    # Max response size (4MB)
                                  # Env: DAWN_URL_FETCHER_FLARESOLVERR_MAX_RESPONSE_BYTES

[url_fetcher.tavily]
# extract_depth = "advanced"      # Tavily extraction mode:
                                  #   "basic"    (1 credit/call): faithful full-page text.
                                  #   "advanced" (2 credits/call): per Tavily docs, returns
                                  #              more content with smarter chrome handling.
                                  #              Live testing on heavy-chrome sites (TipRanks
                                  #              etc.) shows little difference from "basic" —
                                  #              tune per your traffic profile. Default
                                  #              "advanced" preserves headroom; if you're
                                  #              burning quota faster than expected, drop to
                                  #              "basic".
                                  # Env: DAWN_URL_FETCHER_TAVILY_EXTRACT_DEPTH
# timeout_sec = 30                # Request timeout for Tavily /extract calls
                                  # Env: DAWN_URL_FETCHER_TAVILY_TIMEOUT_SEC
# max_response_bytes = 1048576    # Max raw_content size returned to LLM (1 MB)
                                  # Env: DAWN_URL_FETCHER_TAVILY_MAX_RESPONSE_BYTES
# rate_limit_per_minute = 10      # Per-user cap — bounds runaway tool loops
                                  # within one minute. Both /search and /extract
                                  # count against the same bucket.
                                  # Env: DAWN_URL_FETCHER_TAVILY_RATE_LIMIT_PER_MINUTE
# rate_limit_per_hour = 100       # Sustained per-user ceiling.
                                  # Env: DAWN_URL_FETCHER_TAVILY_RATE_LIMIT_PER_HOUR
# rate_limit_per_day = 500        # GLOBAL ceiling across all users —
                                  # monthly-quota backstop. Sized for Tavily's
                                  # 1000/mo free tier with cushion. Raise if
                                  # on a paid plan.
                                  # Env: DAWN_URL_FETCHER_TAVILY_RATE_LIMIT_PER_DAY

# =============================================================================
# MQTT (Home Automation)
# =============================================================================

[mqtt]
# enabled = true                  # Enable MQTT integration
                                  # Env: DAWN_MQTT_ENABLED
# broker = "127.0.0.1"            # MQTT broker hostname/IP
                                  # Env: DAWN_MQTT_BROKER
# port = 1883                     # MQTT broker port (8883 for TLS)
                                  # Env: DAWN_MQTT_PORT
# tls = false                     # Enable TLS encryption
                                  # Env: DAWN_MQTT_TLS
# tls_ca_cert = ""                # CA certificate path (empty = system default)
                                  # Env: DAWN_MQTT_TLS_CA_CERT
# tls_cert_path = ""              # Client certificate for mutual TLS (optional)
                                  # Env: DAWN_MQTT_TLS_CERT_PATH
# tls_key_path = ""               # Client private key for mutual TLS (optional)
                                  # Env: DAWN_MQTT_TLS_KEY_PATH
# Note: Credentials go in secrets.toml under [mqtt]
#       or use env vars: MQTT_USERNAME, MQTT_PASSWORD

# =============================================================================
# Network (shared settings for sessions, workers, LLM timeouts)
# =============================================================================

[network]
# workers = 4                     # Concurrent processing threads
                                  # Env: DAWN_NETWORK_WORKERS
# session_timeout_sec = 1800      # Idle session expiry (30 minutes)
                                  # Env: DAWN_NETWORK_SESSION_TIMEOUT_SEC
# llm_timeout_ms = 60000          # Per-request LLM timeout (60 seconds)
                                  # Env: DAWN_NETWORK_LLM_TIMEOUT_MS
# summarization_timeout_ms = 180000  # LLM timeout for context summarization (3 min)
                                  # Env: DAWN_NETWORK_SUMMARIZATION_TIMEOUT_MS

# =============================================================================
# Web UI
# =============================================================================

[webui]
# enabled = false                 # Enable Web UI server (set true to use browser interface)
                                  # Env: DAWN_WEBUI_ENABLED
# port = 3000                     # HTTP/WebSocket port
                                  # Env: DAWN_WEBUI_PORT
# bind_address = "0.0.0.0"        # Bind address (0.0.0.0 = all interfaces)
                                  # Env: DAWN_WEBUI_BIND_ADDRESS
# max_clients = 4                 # Max concurrent WebSocket clients
                                  # Env: DAWN_WEBUI_MAX_CLIENTS
# audio_chunk_ms = 100            # Audio chunk size for streaming (100-500ms)
                                  # Env: DAWN_WEBUI_AUDIO_CHUNK_MS
# workers = 1                     # ASR worker threads for voice input
                                  # Env: DAWN_WEBUI_WORKERS
# www_path = "www"                # Path to static web files
                                  # Env: DAWN_WEBUI_WWW_PATH

# SSL/HTTPS (required for microphone access from non-localhost)
# https = false                   # Enable HTTPS
                                  # Env: DAWN_WEBUI_HTTPS
# ssl_cert_path = ""              # Path to SSL certificate (.pem or .crt)
                                  # Env: DAWN_WEBUI_SSL_CERT_PATH
# ssl_key_path = ""               # Path to SSL private key (.pem or .key)
                                  # Env: DAWN_WEBUI_SSL_KEY_PATH

# =============================================================================
# Image Storage (vision uploads)
# =============================================================================

[images]
# retention_days = 0              # Delete DEFAULT-retention images after N days (0 = never)
# max_size_mb = 4                 # Maximum size per uploaded image in MB
# max_per_user = 1000             # Maximum stored images per user
# cache_size_mb = 200             # LRU cache cap for search/cached images in MB

[vision]
# max_image_size_kb = 4096        # Maximum image upload size in KB
                                  # Range: 512-16384
# max_dimension = 1024            # Maximum image width/height in pixels
                                  # Range: 256-4096
# max_images = 5                  # Maximum images per message
                                  # Range: 1-10
# capture_history_count = 1       # Tool-captured images (e.g. the `viewing` camera tool) kept
                                  # visible in conversation history for follow-up questions.
                                  # 0 = unlimited: images are only bounded by normal context
                                  # compaction (no per-capture eviction), so a long session with
                                  # repeated captures can grow noticeably before compaction runs.
                                  # Range: 0-50

# =============================================================================
# Document Library (RAG)
# =============================================================================

[documents]
# max_file_size_kb = 10240        # Maximum upload file size in KB (default 10 MB)
                                  # Range: 64-10240
                                  # Env: DAWN_DOCUMENTS_MAX_FILE_SIZE_KB
# max_documents = 5               # Maximum documents per upload batch
                                  # Range: 1-20
                                  # Env: DAWN_DOCUMENTS_MAX_DOCUMENTS
# max_pages = 100                 # Maximum pages to extract from PDFs
                                  # Range: 1-500
                                  # Env: DAWN_DOCUMENTS_MAX_PAGES
# max_extracted_size_kb = 1024    # Maximum extracted text size in KB
                                  # Range: 128-4096
                                  # Env: DAWN_DOCUMENTS_MAX_EXTRACTED_SIZE_KB
# max_index_size_kb = 2048        # Maximum text size to index for search in KB
                                  # Range: 128-10240
                                  # Env: DAWN_DOCUMENTS_MAX_INDEX_SIZE_KB
# max_indexed_documents = 50      # Maximum documents with search indexes
                                  # Range: 1-500
                                  # Env: DAWN_DOCUMENTS_MAX_INDEXED_DOCUMENTS

# --- Hybrid document search (v61): lexical BM25 + semantic cosine + phrase bonus ---
# Document search fuses a keyword (BM25) channel with the semantic (embedding)
# channel.  The label/filename column is weighted high so a "note" saved under a
# label is retrieved exactly by that label.  Defaults are tuned to match the
# memory subsystem's keyword/vector balance; raise fts_label_weight if exact-label
# lookups under-rank, or search_min_score to suppress weak matches.
# fts_label_weight = 3.0          # BM25 weight for the label/filename column (0-100)
# fts_body_weight = 1.0           # BM25 weight for the chunk-text column (0-100)
# hybrid_keyword_weight = 0.3     # Lexical (BM25) fusion weight (0-1)
# hybrid_vector_weight = 0.7      # Semantic (cosine) fusion weight (0-1)
# phrase_bonus_weight = 0.25      # Ordered/contiguous phrase-match bonus scale (0-1)
# search_min_score = 0.3          # Post-fusion relevance gate; below this is dropped (0-1)

# --- Note/document version history (v62): undo edits + recover deletes ---
# Every edit, overwrite, or delete first archives the prior content as a version
# so changes are undoable and deletes are recoverable for a window.  Set
# version_retention_days = 0 to disable versioning entirely.
# version_retention_days = 14     # Days a version is kept before retention sweeps it (0 = off)
                                  # Range: 0-365
# version_keep_per_doc = 10       # Max versions retained per item (newest kept)
                                  # Range: 1-100

# --- Original-file storage (v68): keep the raw uploaded PDF/DOCX ---
# Stores the original upload alongside the extracted text so it can be downloaded
# later and re-processed if extraction improves (OCR, charts, media gallery).
# Kept forever by default; an orphan sweep reclaims only uploads that were never
# saved into a conversation/library and files left after a document is deleted.
# originals_enabled = true              # Store original uploads (default: on)
# original_retention_days = 0           # Age-delete originals after N days (0 = keep forever)
                                        # Range: 0-3650
# max_original_size_mb = 10             # Largest original to store (<= upload limit)
                                        # Range: 1-512
# max_originals_per_user = 200          # Per-user count cap
                                        # Range: 1-100000
# max_originals_total_mb_per_user = 2048  # Per-user aggregate cap in MB (0 = unlimited)
                                        # Range: 0-1048576
# original_grace_minutes = 45           # Orphan grace before the sweep reclaims an
                                        # uploaded-but-unsaved original (Range: 0-1440)

# =============================================================================
# Persistent Memory System
# =============================================================================

[memory]
# enabled = true                  # Enable persistent user memory
# context_budget_tokens = 800     # Max tokens for memory context in system prompt
# extraction_provider = "local"   # LLM provider for fact extraction: "local", "openai", "claude"
# extraction_model = "qwen2.5:7b" # Model for memory extraction
                                  # Recommended: claude-haiku-4-5 (validated by the four-model
                                  # LoCoMo sweep — see benchmarks/README.md "four-model extraction
                                  # sweep results"). Sonnet only beats Haiku by +1.7 pp on
                                  # recall_generation; Opus is *worse* than Haiku (entity over-
                                  # fragmentation). Going to a larger Claude tier is not a free
                                  # win for extraction.
# extraction_openrouter_model = "" # Extraction model when the OpenRouter gateway is on
                                  # ("vendor/model", e.g. anthropic/claude-3.5-haiku).
                                  # Empty = main OpenRouter default.
# extraction_timeout_ms = 120000  # LLM timeout for fact extraction (2 min)
                                  # Env: DAWN_MEMORY_EXTRACTION_TIMEOUT_MS
# note_extraction_guard = true    # Keep reference text filed via the document_manage
                                  # save_note/save_text tool out of semantic memory
                                  # facts. At extraction time the filed bodies (and
                                  # their echoes in document_read/document_search tool
                                  # results) are redacted from the extraction input so
                                  # the canonical text lives only in the note store, not
                                  # duplicated — and re-mined — as a fact that then goes
                                  # stale when the note is edited. Exact-match redaction
                                  # (zero false positives). Default on.
# pruning_enabled = true          # Automatically remove old superseded and stale facts
# prune_superseded_days = 30      # Keep superseded facts for N days before deletion
# prune_stale_days = 180          # Delete low-confidence facts not accessed in N days
# prune_stale_min_confidence = 0.50  # Only prune stale facts with confidence below this
# Fact expiry / ephemerality (C3) — auto-expire transient dated facts (weather
# forecasts, scheduled-not-yet-happened events).  Off by default.  When on,
# extraction tags such facts with an expires_at; they leave retrieval once it
# passes (reversible) and are hard-deleted by the nightly prune after the window.
# expire_enabled = false          # Master gate for fact expiry
# expire_grace_days = 7           # Keep an expiring fact visible N days past its reference date
# prune_expired_days = 30         # Recoverable buffer before hard-delete (0 = delete on expiry)
# conversation_idle_timeout_min = 15  # Auto-save voice conversations after N minutes idle
                                  # (0 = disabled, minimum 10 if enabled)
# default_voice_user_id = 1       # User account for local microphone and DAP conversations

[memory.decay]
# enabled = true                  # Enable nightly confidence decay
# hour = 2                        # Hour to run decay (0-23, local time)
# inferred_weekly = 0.95          # Weekly decay multiplier for inferred facts (5%/week)
# explicit_weekly = 0.98          # Weekly decay multiplier for explicit facts (2%/week)
# preference_weekly = 0.97        # Weekly decay multiplier for preferences (3%/week)
# inferred_floor = 0.0            # Min confidence for inferred facts (0 = can decay to zero)
# explicit_floor = 0.50           # Min confidence for explicit facts (never fully forgotten)
# preference_floor = 0.40         # Min confidence for preferences
# prune_threshold = 0.25          # Delete facts with confidence below this after decay
# summary_retention_days = 30     # Delete conversation summaries older than N days
# access_reinforcement_boost = 0.05  # Confidence boost when a fact is accessed (+5%)
                                  # Time-gated: only boosts once per hour to prevent pinning

[memory.embeddings]
# provider = "onnx"               # Embedding provider: "onnx" (local), "ollama", or "openai"
                                  # "onnx" runs on-device with no external dependency
                                  # Env: DAWN_MEMORY_EMBEDDINGS_PROVIDER
# model = ""                      # Model name (provider-specific, empty = provider default)
                                  # Env: DAWN_MEMORY_EMBEDDINGS_MODEL
# endpoint = ""                   # API endpoint (for "ollama" or "openai" providers)
                                  # Env: DAWN_MEMORY_EMBEDDINGS_ENDPOINT
# keyword_weight = 0.30           # Weight for keyword matching in hybrid search (0.0-1.0)
                                  # Env: DAWN_MEMORY_EMBEDDINGS_KEYWORD_WEIGHT
# vector_weight = 0.70            # Weight for vector similarity in hybrid search (0.0-1.0)
                                  # Env: DAWN_MEMORY_EMBEDDINGS_VECTOR_WEIGHT
# temporal_weight = 0.20          # Boost for date-anchored queries ("last week",
                                  # "in 2023", "summer 2022"). 0 disables. 0.20
                                  # validated on LongMemEval temporal-reasoning
                                  # (+2.3pp R@10) and LoCoMo cat-2 (+3.2pp).
# category_threshold = 0.25       # Cosine similarity threshold for auto-categorizing
                                  # memories. Calibrated for MiniLM-L6. Lower values
                                  # classify more facts; higher = more selective.
                                  # Range: 0.05-0.95
# search_score_floor = 0.30       # "I don't remember" gate — drops marginal-cosine
                                  # hits from memory.search and per-turn focus
                                  # injection before they reach the LLM. Closes the
                                  # floor against fabrication from weak similarity.
                                  # 0 disables. Default 0.30 sits at the natural
                                  # keyword-weight boundary (kw_weight * 1.0) — every
                                  # legitimate single-token keyword match passes;
                                  # only hybrid-vector-only marginal hits are
                                  # filtered. Drop to 0.10-0.20 if over-filtering,
                                  # push higher if weak fabrications persist.
                                  # Range: 0.0-1.0.
# bm25_enabled = true             # BM25 keyword retrieval (FTS5 + Porter2 stemming).
                                  # When on, the keyword channel of memory.search
                                  # uses SQLite FTS5 with bm25() ranking + Porter2
                                  # stems, instead of the legacy SQL LIKE +
                                  # multi-token match-count path. Catches plurals
                                  # + verb tenses ("memories"→"memori",
                                  # "attending"→"attend") and ranks rare-term
                                  # matches above common-term matches. Algorithm
                                  # + sigmoid params adapted from Mem0
                                  # (Apache-2.0; see NOTICE). Graduated to
                                  # default-on (May 17, 2026) after Phase 1 Mem0
                                  # parity bench validation: +2.74pp leader-
                                  # comparable on fresh LoCoMo n=1536. Set to
                                  # false to revert to the legacy LIKE path.
# rrf_enabled = false             # Reciprocal Rank Fusion (parallel-channel
                                  # alternative to the weighted-sum composite
                                  # scorer). FORMALLY DEAD-LETTER (May 17, 2026):
                                  # original 2026-05-15 bench -3.7pp; re-tested
                                  # post Phase 1 BM25 + Phase 3 specificity rules
                                  # still -0.58pp. Code stays behind the flag for
                                  # operator override but the design does not
                                  # compose with DAWN's entity-graph backbone.
                                  # Do not enable for production.
# memory_text_minimal = true      # Compact memory_text rendering — strip per-fact
                                  # metadata, demote source excerpts to a single
                                  # global block. Graduated default-on (May 2026)
                                  # after +0.98pp leader-comparable validation;
                                  # re-confirmed post Phase 3 (Phase 4B of Mem0
                                  # parity): -0.71pp without minimal. Cuts ~30-50%
                                  # of memory_text bytes. Set false to restore
                                  # verbose per-fact rendering.
# temporal_filter_enabled = true  # Hard temporal filter on memory.search results
                                  # (parser-recognized date queries skip results
                                  # outside the resolved window). Graduated
                                  # default-on (May 2026) after +3.6pp validation
                                  # on LongMemEval temporal-reasoning; LoCoMo-
                                  # blind but no regression. Complements (does
                                  # not replace) the soft temporal_weight above.
# backfill_on_startup = true      # Generate missing embeddings on startup
                                  # Env: DAWN_MEMORY_EMBEDDINGS_BACKFILL_ON_STARTUP
# model_id = "bge-small-en-v1.5-int8"
                                  # Human-readable identity string for the current
                                  # embedding model.  Bump this whenever MODEL_PATH
                                  # changes; the recompute worker detects the mismatch
                                  # and re-indexes all stored embeddings automatically.
# recompute_on_model_change = true
                                  # Re-embed all memories when model_id changes.
                                  # Disable only as an emergency ops escape hatch
                                  # (logs a warning when false).
# recompute_batch_size = 50       # Rows per batch during re-indexing (1-500)
# recompute_batch_sleep_ms = 100  # Sleep between batches in ms (0-5000).
                                  # Throttles CPU; increase to reduce background load.

[memory.graph_retrieval]
# Entity-graph candidate retrieval for memory.search.  Phase 1A walks 1 hop
# from query-extracted proper-noun seeds via fact-linked relations.  Phase 2
# Step 1 (May 14, 2026) added query-aware scoring of graph candidates
# (+1.1pp cat-3 on LoCoMo with no regressions).
# enabled = true                   # Default-on; disable to A/B against pure hybrid
# entity_grounding_bonus = 0.40    # Legacy flat score for graph candidates when
                                   # use_query_scoring=false.  Range [0.0, 1.0].
# max_facts_per_query = 30         # Total fan-out cap across all seeds per query.
                                   # Range [1, 200].
# use_query_scoring = true         # Phase 2 Step 1: re-score graph candidates
                                   # against the query (vec_weight*cosine +
                                   # entity_bonus) instead of using the flat
                                   # entity_grounding_bonus.  Default true.
                                   # Set false to revert to flat-bonus scoring
                                   # for config-toggle ablation.
# entity_bonus = 0.0               # Additive bonus applied to query-scored graph
                                   # candidates on top of vec_weight*cosine.  Default
                                   # 0.0 — the bonus was found to act as an asymmetric
                                   # thumb-on-scale (only graph-branch facts received
                                   # it, displacing equally-relevant hybrid hits).
                                   # Experimental knob; set >0 to test symmetric-
                                   # bonus designs only.  Range [0.0, 1.0].

[memory.recovery]
# Re-runs memory extraction on conversations whose last_extracted_msg_count
# is behind message_count after the configured idle window.  Catches sessions
# left unconsolidated by daemon crashes or extraction failures.  A worker
# thread runs an immediate startup pass and then re-scans on the recurring
# interval.  Each conversation is processed sequentially so extraction never
# competes with itself.
# enabled = true                  # Enable extraction recovery
# idle_threshold_seconds = 3600   # Minimum idle time (seconds) before recovery
                                  # considers a conversation stuck.  Default 1 h.
                                  # Range: 60 - 2592000
# max_attempts = 2                # Cap on retries per conversation.  Activity
                                  # on the conversation auto-resets the counter.
                                  # 0 disables the cap.  Default 2.
# recurring_interval_seconds = 86400  # Cadence of the recurring scan after
                                      # the startup pass.  0 = startup-only.
                                      # Default 86400 (daily).

[memory.focus_injection]
# Per-turn dynamic context injection (Phase 1 of the dynamic context
# injection workstream).  When enabled, the daemon retrieves
# memory facts, entities, relations, summaries, document chunks, calendar
# events, and recent emails relevant to each user turn and injects them
# as a budget-bounded "current context" block in the LLM prompt.
# Currently disabled by default — adapters land in Phase 1c/1d.
# enabled = false                     # Master enable
# focus_budget_bytes = 10240          # Byte cap on the assembled focus block (per turn).
                                      # Range: 1024 - 65536  (~4 bytes/token; exact byte budget)
# top_k = 12                          # Maximum candidates retained after ranking.
                                      # Range: 1 - 64.  Bumped 8 → 12 (May 2026,
                                      # post-Step-3 semantic summary adapter):
                                      # at 8 facts filled every slot and starved
                                      # summaries/entities/relations from
                                      # surfacing per turn.
# summary_max_scan = 4096              # Rows the semantic summary adapter
                                      # inspects per turn before the cosine
                                      # ranking heap.  Range: 256 - 16384.
                                      # Original 256 broke when a full
                                      # `dawn-admin memory reextract`
                                      # clustered every summary's created_at
                                      # into a narrow window — recency-
                                      # ordered LIMIT dropped the oldest-
                                      # extracted rows.  Bump above 4096
                                      # only if your corpus crosses that
                                      # threshold and you observe drops.
# min_score = 0.4                     # Floor — anything below is dropped.
                                      # Range: 0.0 - 1.0
# classifier_enabled = false          # RAGRoute-style source classifier
                                      # (default off — opt-in only after probe).
# weight_semantic = 1.0               # Generative-Agents three-factor ranker
# weight_recency = 0.30               # weights.  Range each: 0.0 - 5.0.  Phase
# weight_importance = 1.0             # 1j tuning (May 2026) lifted w_imp 0.2 →
                                      # 1.0 and dropped w_rec 0.3 → 0.15 — Probe
                                      # Component 6 fix-rate 7/11 → 11/11 across
                                      # anthropic / openai / local providers.
                                      # Phase 1j re-bench (2026-05-13) promoted
                                      # w_rec 0.15 → 0.30 after adding summary-
                                      # relevant probes (cases 12-15): Run B at
                                      # 0.30 produced 15/15 across all three
                                      # providers with no regression on the
                                      # regression-guard or existing cases.
                                      # See atlas/dawn/memory/PHASE_1J_TUNING_LOG.md
                                      # for the full bench history.
# weight_source = 1.0                 # Multiplier on per-source weights below.

[memory.focus_injection.source_weights]
# Per-source contribution to the final score.  Default tuning matches
# the design doc; tighten / loosen during 1j bench tuning.
# memory_fact = 1.0
# memory_entity = 0.9
# memory_relation = 0.85
# memory_summary = 1.0                # Bumped 0.7 → 1.0 (May 2026, post-Step-3).
                                      # The 0.7 was a guess from before the
                                      # semantic summary adapter shipped; at 0.7
                                      # summaries lost the ranking competition
                                      # to facts on every turn even when cosine
                                      # was strong.  Parity with memory_fact
                                      # lets summaries compete on raw signal.
# document_chunk = 0.7
# calendar_event = 0.6
# recent_email = 0.5
# dawn_background = 0.8               # Phase 2

[memory.focus_injection.dedup]
# Re-injection policy.  Active when [memory.focus_injection].enabled = true;
# dedup is a correctness layer on top of focus injection (no separate enable
# flag — the two knobs below ARE the tuning surface).
#
# An item is re-injected on a later turn only if EITHER:
#   - turns_since_last_inject > recent_window_turns AND current_score >= min_score
#       (strict greater-than: at recent_window_turns=8, turn 9+ admits)
#   - current_score >= prior_score * score_uplift_factor
#       (uplift path admits regardless of window)
#
# Tuning notes:
#   - recent_window_turns = 0 effectively disables time-based dedup —
#     turns_since=1 already passes, so only score_uplift can suppress.
#   - High recent_window_turns (≤100) requires score-uplift for re-admission,
#     useful for "only show this fact if it gets noticeably more relevant."
# recent_window_turns = 8             # Range: 0 - 100
# score_uplift_factor = 1.5           # Range: 1.0 - 5.0

# =============================================================================
# [memory.focus_injection.dominant_token_heuristic]
#
# Phase B-ii structural fix for low-IDF dominant-token cosine over-
# inclusion (the pathology probed by focus_probe_cases.json cases
# 16-18).  When a user query has a low-IDF dominant token like
# "favorite restaurant" or "doctor blood test" AND > threshold of
# the candidate pool shares that token AND the right-answer summary
# uses specific vocabulary instead, pure cosine + weight tuning
# cannot rescue the right answer — the semantic gap exceeds any
# recency lift safe parameters allow.  This heuristic detects the
# shape per-turn and applies a composite-score penalty to candidates
# whose query-overlap is ONLY via the dominant tokens.
#
# Bench-validated 18/18 quorum across all three providers
# (anthropic/openai/local) on the 18-case fixture suite — see
# docs/RERANKER_PHASE_A_DESIGN.md for the full bench history.
# =============================================================================
# [memory.focus_injection.dominant_token_heuristic]
# enabled = true                      # Default on after Phase B-ii ship
# threshold = 0.60                    # Pool fraction to call a token
#                                     # dominant.  Range: 0.0 - 1.0.
# base_penalty = 0.40                 # Max composite-score penalty per
#                                     # candidate.  Range: 0.0 - 1.0.

# =============================================================================
# Entity-merge auto-merge gate (Phase 2)
# =============================================================================
# After each extraction, freshly-created entities are scored against existing
# canonicals via the resolver cascade (name jaccard + embedding cosine +
# exclusive relation overlap + contact overlap + type match + substring
# bonus + user-self bonus).  Outcome routing:
#
#   composite >= auto_threshold    → soft-link written silently (no
#                                    operator approval, so keep this high)
#   composite >= review_threshold  → proposal queued for operator approval
#                                    via the WebUI Memory → Graph tab's
#                                    "Suggested merges" panel
#   else                           → entity stays as its own canonical
#
# Lower review_threshold = catches more duplicates but more clicks to
# triage.  Operator approval is the gate, so false positives are cheap.
# Calibrate against your corpus by watching the WebUI proposal queue's
# precision (approve rate).
#
# `enabled` is a kill-switch for the auto-fire-on-extraction path only.
# Operator-driven merges (link-user-self, WebUI merge button) work
# regardless.
[memory.entity_merge]
# enabled = true                      # Auto-evaluate freshly-extracted entities
# auto_threshold = 0.90               # Range: 0.30 - 1.00 (keep conservative)
# review_threshold = 0.50             # Range: 0.10 - 1.00 (lower = more proposals)

# =============================================================================
# Scheduler (timers, alarms, reminders)
# =============================================================================

[plan_executor]
# timeout_seconds = 60             # Maximum execution time for multi-step plans
                                   # Range: 5-300

[scheduler]
# enabled = true                  # Enable scheduler system
# default_snooze_minutes = 10     # Default snooze duration
# max_snooze_count = 10           # Maximum snooze attempts per event
# max_events_per_user = 50        # Maximum active events per user
# max_events_total = 200          # Maximum active events system-wide
# missed_event_recovery = true    # Fire missed events on startup
# missed_task_policy = "skip"     # Missed scheduled tasks: "skip" or "execute"
# missed_task_max_age_sec = 300   # Max age for executing missed tasks (5 minutes)
# alarm_timeout_sec = 60          # Auto-dismiss alarms after N seconds
# alarm_volume = 80               # Alarm chime volume (0-100)
# event_retention_days = 30       # Keep completed events for N days
# When a briefing fires, voice-created briefings (local mic / satellite) always
# speak the LLM-summarized result via TTS — the user asked aloud, they expect
# to hear it.  WebUI-created briefings are silent by default (the conversation
# IS the artifact).  Set to true to also speak WebUI-created briefings.
# briefing_speak_aloud_on_webui_source = false

# =============================================================================
# Music Playback
# =============================================================================

[music]
# scan_interval_minutes = 60      # Rescan music library for new files (minutes)
# streaming_enabled = true        # Enable Opus streaming to WebUI and satellites
# streaming_quality = "standard"  # Opus encoding quality
# streaming_bitrate_mode = "vbr"  # Bitrate mode: "vbr" or "cbr"

[sfx]
# sound_path = "sound_assets/"    # Directory containing sound effect files
                                  # Env: DAWN_SFX_SOUND_PATH

# =============================================================================
# Home Assistant (smart home control)
# =============================================================================
# REST + WebSocket client for Home Assistant Core/OS. See docs/HOMEASSISTANT_SETUP.md
# for a bare-metal HA Core install guide (e.g. running alongside DAWN on the same
# Jetson). Long-lived access token lives in secrets.toml under [secrets.home_assistant].

[home_assistant]
# enabled = true                   # Enable the Home Assistant tool
# url = "http://homeassistant.local:8123/"  # Base URL of the HA instance
# led_hue_correction = 20          # Degrees to shift magenta region toward red (0-60),
                                    # for RGB light color-name matching

# =============================================================================
# Calendar (CalDAV)
# =============================================================================

[calendar]
# enabled = false                 # Enable CalDAV calendar integration
                                  # Env: DAWN_CALENDAR_ENABLED
# sync_interval_sec = 900         # Background sync interval in seconds (15 min)
                                  # Range: 60-86400
                                  # Env: DAWN_CALENDAR_SYNC_INTERVAL_SEC
# cache_past_days = 30            # Cache events this many days in the past
                                  # Range: 0-365
                                  # Env: DAWN_CALENDAR_CACHE_PAST_DAYS
# cache_future_days = 365         # Cache events this many days in the future
                                  # Range: 7-730
                                  # Env: DAWN_CALENDAR_CACHE_FUTURE_DAYS
# default_event_duration_min = 60 # Default event duration in minutes (when not specified)
                                  # Range: 5-480
                                  # Env: DAWN_CALENDAR_DEFAULT_EVENT_DURATION_MIN
# Note: Calendar accounts are managed in the WebUI Settings panel.
#       Account credentials are stored encrypted in the database.

# =============================================================================
# Messaging Channels (Telegram / Discord / Slack / SMS)
# =============================================================================
# Unified LLM-facing tool for sending and receiving across chat apps and SMS.
# Driver tokens (telegram_bot_token, etc.) live in secrets.toml.
# Channel bindings are managed via the /link flow from the chat app.

[messaging.sms]
# active_window_sec = 600           # SMS-only: window after the last LLM-bound
                                    # exchange during which subsequent SMS from
                                    # the same linked sender bypass the
                                    # wake-word gate and route directly to the
                                    # LLM.  Outside the window, an SMS without
                                    # a wake-word falls through to existing
                                    # MIRAGE HUD + ctx-inject behavior.  The
                                    # conversation thread (one conv_id per
                                    # channel) persists across windows — this
                                    # only controls LLM routing, not lifetime.
                                    # Set to 0 to disable.  Range: 0-86400
                                    # (default: 600 = 10 minutes).

# =============================================================================
# Proactive attention (SAGE)
# =============================================================================
# DAWN watches live telemetry (STAT / suit / helmet-link) and speaks up on its
# own when a WATCH you've set fires — "power's at twelve percent, sir".  Only
# operator-level knobs live here; the watches themselves are managed by voice or
# the WebUI Watches panel ("Friday, keep an eye on the CO2", "ignore that temp
# for now"), NOT in this file.  Master switch is OFF by default.

[attention]
# enabled = false                 # Master switch (evaluation + delivery).
# max_alerts_per_hour = 4         # Global spoken-alert budget; over-budget
                                  #   alerts degrade to a silent banner. 0-100.
# inject_into_sessions = false    # Also make an active conversation aware of a
                                  #   fired alert (so Friday can reference it).
# judge_enabled = false           # P2 LLM salience judge (not yet active).
# judge_threshold = 3.5           # P2 score floor (1.0-5.0).
# quiet_hours = ""                # P1 quiet-hours window, e.g. "23:00-07:00".

# =============================================================================
# Background jobs
# =============================================================================
# Fire-and-forget tasks ("research X, tell me when done"). A job IS a parented
# conversation run in its own text-only session pool, so a job can never starve
# an audio-bound WebUI/satellite client. These caps are LLM-resource-bound plus
# DoS guards; creating/listing/cancelling jobs is conversational (the `job` tool
# and the WebUI), never config. See docs/BACKGROUND_JOBS_DESIGN.md §7.

[jobs]
# enabled = true                     # Master switch for background jobs.
# max_concurrent_local = 1           # Jobs at once on a LOCAL (GPU) model. Keep
                                     #   at 1 on a single GPU. 0 = none.
# max_concurrent_cloud = 4           # Jobs at once on a CLOUD model (cheap to
                                     #   parallelize). Counted separately.
# max_active_jobs = 16               # GLOBAL running ceiling, all users. Sizes
                                     #   the job-session pool array. 1-256.
# max_jobs_per_user = 4              # Per-user concurrent running cap.
# max_runtime_sec = 1800             # Per-job time budget. A job past this is
                                     #   reaped (marked failed, follow-up STILL
                                     #   fires) so a wedged worker can't hold a
                                     #   pool slot forever. 0 = no limit.
# max_reinvokes_per_tree = 8         # Runaway guard: stop re-engaging the parent
                                     #   after this many attempts on one job.
# max_concurrent_reinvokes = 2       # In-flight reinvoke_parent workers. 1-32.
# monitor_followups_per_tick = 4     # Completion follow-ups drained per 1s
                                     #   heartbeat (bounds work on the voice loop).
#
# Parsed and round-tripped, but NOT yet enforced — reserved for the Phase 2
# (durable event log) and Phase 3 (job trees) work. Setting them has no effect:
# max_queued_per_user = 8            # Phase 2/3: per-user queued backlog.
# max_spawn_depth = 3                # Phase 3: job-tree depth cap.
# max_children_per_tree = 4          # Phase 3: active children per parent.
# event_chunk_cap = 16384            # Phase 2: event-payload truncation bytes.

# =============================================================================
# OTA (over-the-air satellite updates)
# =============================================================================
# Server→satellite firmware updates. Release artifacts are signed OFFLINE with
# ota-keytool (the daemon never holds the signing key); the daemon only serves
# them and devices verify against a baked-in public keyring. See docs/OTA_DESIGN.md.

[ota]
# enabled = false                    # Master switch for serving OTA updates.
# release_dir = "/var/lib/dawn/ota"  # Root of signed releases:
                                    #   <release_dir>/<platform>/<version>/{image,manifest,manifest.sig}
# download_token_ttl_sec = 120       # One-time image-download token lifetime (5-3600).
# require_tls = true                 # Refuse OTA control/download over plaintext.

# =============================================================================
# Shutdown Control
# =============================================================================

[shutdown]
# enabled = false                 # Enable voice/command shutdown (security risk)
                                  # Env: DAWN_SHUTDOWN_ENABLED
# passphrase = ""                 # Required passphrase (empty = no passphrase)
                                  # Env: DAWN_SHUTDOWN_PASSPHRASE

# =============================================================================
# Terminal UI (TUI)
# =============================================================================

[tui]
# enabled = false                 # Enable ncurses TUI dashboard
                                  # Env: DAWN_TUI_ENABLED

# =============================================================================
# Debug Settings
# =============================================================================

[debug]
# mic_record = false              # Record raw microphone input
                                  # Env: DAWN_DEBUG_MIC_RECORD
# asr_record = false              # Record audio sent to ASR
                                  # Env: DAWN_DEBUG_ASR_RECORD
# aec_record = false              # Record AEC processed audio
                                  # Env: DAWN_DEBUG_AEC_RECORD
# record_path = "/tmp"            # Directory for debug recordings
                                  # Env: DAWN_DEBUG_RECORD_PATH
# silent_observe_test_endpoint = false  # Expose POST /api/test/silent_observation
                                  # Dev-only: lets developer fire a fake silent
                                  # observation event from the WebUI.  Off by
                                  # default — never enable in production.

# =============================================================================
# File Paths
# =============================================================================

[paths]
# data_dir = "~/.local/share/dawn"  # Database storage directory
                                  # Env: DAWN_PATHS_DATA_DIR
# music_dir = "~/Music"           # Music library location for playback
                                  # Env: DAWN_PATHS_MUSIC_DIR
# commands_config = "commands_config_nuevo.json"  # Device/command mappings for MQTT
                                  # Env: DAWN_PATHS_COMMANDS_CONFIG

# =============================================================================
# Phone (calls and SMS via ECHO modem daemon)
# =============================================================================

[phone]
# enabled = true                    # Enable phone tool
# confirm_outbound = true           # Require "confirm" before dialing or sending SMS
# user_id = 1                       # User who owns the modem (contacts/logs scoped to this user)
# audio_device = ""                 # USB sound card device for call audio (e.g. "hw:2,0")
# sms_retention_days = 90           # Auto-delete SMS logs older than N days
# call_log_retention_days = 90      # Auto-delete call logs older than N days
# rate_limit_sms_per_min = 5        # UX rate limit: max SMS per minute
# rate_limit_calls_per_min = 3      # UX rate limit: max dial attempts per minute
# rate_limit_sms_per_day = 30       # UX rate limit: max SMS per day
#
# --- Call audio (local-handset two-way voice) ---
# The modem's USB PCM tap is raw 16 kHz S16LE; no modem-side gain touches it, so
# all level control is host-side.  The uplink (local mic -> far end) is cleaned by
# a WebRTC near-end chain (high-pass -> noise-suppression -> AGC2), which fixes
# "microphone-y / threshold-y / pumping" audio.  Tune these on a live 2-party call.
# pcm_port: modem USB audio device node (if06 on the SIM7600G-H). Prefer a stable
# /dev/serial/by-id/ alias over a raw /dev/ttyUSBn — raw numbers reshuffle when
# another USB-serial device is added at boot (find yours: ls -l /dev/serial/by-id/).
# A /dev/serial/by-path/ alias also works (topology-keyed; use it if you ever run a
# second device with the SIM7600's default serial 0123456789ABCDEF). Blank = default.
# pcm_port = "/dev/serial/by-id/usb-SimTech__Incorporated_SimTech__Incorporated_0123456789ABCDEF-if06-port0"
# uplink_agc = true                  # AGC2 per-frame VAD-gated digital gain
# uplink_fixed_gain_db = 1.0         # static pre-gain, dB (clamped 0..49; >=50 disables AGC2)
# uplink_agc_ramp_db_per_s = 3.0     # AGC ramp rate; lower = less pumping
# uplink_max_output_noise_dbfs = -50.0 # AGC won't lift noise above this floor
# uplink_ns_level = "moderate"       # noise suppression: off|low|moderate|high|veryhigh
# uplink_high_pass = true            # remove DC/handling rumble
# uplink_echo_cancel = true          # AECM on the reverse stream (on if the far end hears themselves)
# Downlink (far end -> speaker): AGC2 normalizes quiet/loud callers a fixed gain can't.
# NS defaults OFF (far end already codec-processed; a 2nd pass sounds "underwater").
# downlink_apm = true                # true -> AGC2 path; false -> tanh soft-limiter (downlink_gain)
# downlink_agc = true                # AGC2 per-frame VAD-gated digital gain
# downlink_fixed_gain_db = 6.0       # static pre-gain, dB (clamped 0..49)
# downlink_agc_ramp_db_per_s = 3.0   # AGC ramp rate; lower = less pumping
# downlink_max_output_noise_dbfs = -50.0 # AGC won't lift noise above this floor
# downlink_ns_level = "off"          # off|low|moderate|high|veryhigh (off recommended)
# downlink_high_pass = true          # remove DC/rumble
# downlink_gain = 8.0                # soft-limiter gain, used only when downlink_apm = false

# =============================================================================
# STAT system telemetry — requires building with -DDAWN_ENABLE_STAT_TOOL=ON
# (default). Subscribes to the external STAT sensor daemon over MQTT and lets
# the assistant answer live + historical system-health questions (temps,
# battery, load, fan). History is downsampled into its own stat.db.
# =============================================================================
[stat]
# enabled = true                    # Enable the system_status tool + ingestion
# telemetry_topic = "stat/telemetry" # MQTT topic STAT publishes metrics on
# status_topic = "stat/status"      # MQTT topic STAT publishes online/offline on
# db_path = "/var/lib/dawn/stat.db" # Self-contained telemetry-history DB
# stale_after_sec = 30              # Live reads older than this report "stale"
# history_retention_days = 30       # Prune history buckets older than N days

# =============================================================================
# Suit telemetry (suit_status tool) — live helmet (AURA) + armor (SPARK) feed
# that MIRAGE republishes on MQTT.  Requires building with -DDAWN_ENABLE_SUIT_TOOL
# (default ON) and MIRAGE republishing helmet/telemetry + armor/telemetry.
# Live cache only (no history store).
# =============================================================================
[suit]
# enabled = true                     # Enable the suit_status tool + ingestion
# helmet_topic = "helmet/telemetry"  # MQTT topic MIRAGE republishes AURA sensors on
# armor_topic = "armor/telemetry"    # MQTT topic MIRAGE republishes SPARK armor on
# stale_after_sec = 30               # Live reads older than this report "stale"

# =============================================================================
# MCP Bridge (coding harness) — requires building with
# -DDAWN_ENABLE_MCP_BRIDGE_TOOL=ON. DAWN is a pure MCP *client*; the operator
# launches each MCP server (systemd/tmux/docker). Transport is HTTP+SSE only.
# =============================================================================
# [mcp]
# enabled = false                    # master switch for the bridge
# dev_mode = false                   # required true to allow any tls_verify=false server
#
# [[mcp.server]]
# alias = "cbm"                      # tool-name prefix, e.g. cbm_search_graph
# url = "http://localhost:9000/sse"  # SSE endpoint of the operator-launched server
# transport = "http+sse"
# enabled = true
# capabilities = "read_only"         # "dangerous" (default) or "read_only"
# request_timeout_seconds = 30
# idle_close_seconds = 600
# tls_verify = true                  # false requires [mcp] dev_mode = true
# auth_bearer_env = "CBM_TOKEN"      # env var holding the bearer token (Phase 1 source)
# # auth_bearer_token_secret = "cbm_token"  # reserved: secrets.toml named-key (not yet wired)

# =============================================================================
# Code Projects (coding harness) — [code_projects]
# =============================================================================
# Import GitHub-style repos (in-process libgit2 clone) and index them through the
# cbm MCP server for code Q&A. Requires the MCP bridge above AND a build with
# -DDAWN_ENABLE_MCP_BRIDGE_TOOL=ON -DDAWN_ENABLE_CODE_PROJECTS=ON. Disabled by
# default; the caps below are secure-by-default.
#
# [code_projects]
# enabled = false                       # master switch (also needs the build flags)
# source_root = "/var/lib/dawn/source"  # where imported repos are cloned
# default_index_mode = "full"           # only "full" is supported today
# default_global = false                # imports default to per-user, not shared
# import_user_required = "admin"        # "" (any user) or "admin" (operator-only import)
# max_repo_size_mb = 2048               # working-tree size cap (enforced post-clone)
# max_file_count = 200000               # working-tree file-count cap
# max_path_depth = 20                   # reject clones nesting deeper than this
# clone_depth = 0                       # 0 = full history, 1 = shallow
# # Host allowlist: POSIX ERE matched against the clone URL host. Auto-anchored
# # (wrapped in ^(...)$), so do NOT add ^ or $ yourself. https:// is required and
# # URLs with embedded credentials are rejected.
# allowed_host_pattern = "([a-z0-9-]+\\.)?(github\\.com|gitlab\\.com|codeberg\\.org|bitbucket\\.org)"
# default_active = ""                   # fallback active project name for new sessions
# # Link-local repos (opt-in): absolute dir prefixes under which an EXISTING local
# # checkout may be linked + indexed without cloning. Empty/unset = link-local
# # disabled. SECURITY: indexed file CONTENTS reach the LLM, so list only
# # secret-free trees; linking is admin-only and never shared globally. The cbm
# # service sandbox must also be granted read access to these paths — see the
# # "Link-local repos" block in services/cbm-mcp/cbm-mcp.service (keep in sync).
# allowed_local_roots = ["/home/dev/code"]

# =============================================================================
# Secrets (separate file)
# =============================================================================
# API keys and credentials should go in secrets.toml (mode 600 recommended)
# See secrets.toml.example for format
#
# Environment variable alternatives:
#   OPENAI_API_KEY, CLAUDE_API_KEY, GEMINI_API_KEY (for LLM)
#   MQTT_USERNAME, MQTT_PASSWORD (for MQTT auth)
