# DAWN Secrets Configuration
# ===========================
# Copy this file to one of:
#   ./secrets.toml                  (project root - highest priority)
#   ~/.config/dawn/secrets.toml     (user - recommended for shared systems)
#   /etc/dawn/secrets.toml          (system-wide)
#
# IMPORTANT: Keep this file secure! Set permissions to 600:
#   chmod 600 secrets.toml
#
# Alternative: Use environment variables instead of this file:
#   OPENAI_API_KEY=sk-...
#   CLAUDE_API_KEY=sk-ant-...
#   GEMINI_API_KEY=...

[secrets]
# Cloud LLM API keys - add at least one
# openai_api_key = "sk-your-openai-key-here"
# claude_api_key = "sk-ant-your-claude-key-here"
# gemini_api_key = "your-gemini-api-key-here"
# OpenRouter key (used when [llm.cloud] provider = "openrouter"). Get one at
# https://openrouter.ai/keys
# openrouter_api_key = "sk-or-your-openrouter-key-here"

# Tavily API key (optional)
# Opt-in commercial search + URL extract API. When set AND
# [search] engine = "tavily" or [url_fetcher] fallback = "tavily",
# DAWN uses Tavily for those calls. Free tier: 1000 calls/month.
# Sign up: https://tavily.com — keys start with "tvly-"
# Env override: TAVILY_API_KEY=tvly-...
# tavily_api_key = "tvly-your-tavily-key-here"

# Pre-shared key for satellite registration (generate with: ./generate_ssl_cert.sh --gen-key)
# satellite_registration_key = ""

# Service token for machine-to-machine image API access (MIRAGE HUD, etc.)
# Generate with: openssl rand -hex 32
# service_token = ""

# Telegram Bot API token (messaging channels feature).
# Get one from @BotFather: https://core.telegram.org/bots#botfather
# Send /newbot, follow the prompts; @BotFather returns a token of the
# shape "123456:ABC-DEF..." — paste it below.  When empty (default),
# the Telegram messaging driver is not loaded.
# See docs/MESSAGING_CHANNELS_SETUP.md for the linking flow.
# telegram_bot_token = ""

# Discord bot token (messaging channels feature).  v1 is DM-only:
# create an application + bot at https://discord.com/developers/applications,
# enable the "MESSAGE CONTENT INTENT" toggle under Bot settings (this
# is a privileged intent — required to see DM message text), then copy
# the bot token here.  When empty (default), the Discord messaging
# driver is not loaded.  See docs/MESSAGING_CHANNELS_SETUP.md.
# discord_bot_token = ""

# Slack Socket Mode tokens (messaging channels feature).  v1 is DM-only,
# single-workspace.  Setup at https://api.slack.com/apps:
#   1. Create app → Enable Socket Mode (generates the App-Level Token
#      "xapp-...").
#   2. OAuth & Permissions → Bot scopes: chat:write, im:history, im:read,
#      app_mentions:read.  Install app to workspace; copy the "Bot User
#      OAuth Token" (xoxb-...) and paste below.
#   3. Event Subscriptions → enable, subscribe to bot events:
#      message.im, app_mention.
# When either token is empty (default), the Slack driver is not loaded.
# See docs/MESSAGING_CHANNELS_SETUP.md (Slack section).
# slack_app_token = "xapp-..."
# slack_bot_token = "xoxb-..."

# Home Assistant Long-Lived Access Token (optional, for smart home control)
# Generate in HA: Profile → Long-Lived Access Tokens → Create Token
# See docs/HOMEASSISTANT_SETUP.md
[secrets.home_assistant]
# token = ""

# Google OAuth 2.0 (for Calendar and Email)
# See docs/GOOGLE_OAUTH_SETUP.md for setup instructions
[secrets.google]
# client_id = "123456789-abc.apps.googleusercontent.com"
# client_secret = "GOCSPX-..."
# redirect_url = "https://your-dawn-host:3000/oauth/callback"

[mqtt]
# MQTT broker credentials (optional)
# username = ""
# password = ""
