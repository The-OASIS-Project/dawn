#!/bin/sh
# Runs as the agent user: pick the credential, then exec Claude Code.  The
# binary is the one the gateway's Python SDK ships, root-owned, so the agent
# can't replace the program that sets up its own sandbox.  An
# ANTHROPIC_API_KEY overrides a `claude login`, so exactly one is used.
unset ANTHROPIC_API_KEY
if [ "$DAWN_AGENT_AUTH" = "api_key" ]; then
   [ -r "$HOME/.config/anthropic.env" ] || { echo "no $HOME/.config/anthropic.env" >&2; exit 1; }
   . "$HOME/.config/anthropic.env"
   export ANTHROPIC_API_KEY
fi
export DISABLE_AUTOUPDATER=1
exec /usr/local/lib/agent-gateway/claude "$@"
